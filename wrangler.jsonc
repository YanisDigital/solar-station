{
  // Имя обязано совпадать с именем проекта на дашборде Cloudflare,
  // иначе Workers Builds падает на этапе деплоя.
  "name": "solar-station",
  "compatibility_date": "2026-09-23",

  // Публикуется не корень репозитория, а собранная папка dist/ — так на CDN
  // гарантированно не попадают .git, README.md, LICENSE и сам этот конфиг.
  // Содержимое dist/ формирует build command, см. README.
  "assets": {
    "directory": "./dist"
  }
}
